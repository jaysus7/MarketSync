+++ b/app/api/website/members/route.ts
@@ -0,0 +1,50 @@
+import { eq } from "drizzle-orm";
+import { getDb } from "../../../../db";
+import { siteMembers } from "../../../../db/schema";
+import { getChatGPTUser } from "../../../chatgpt-auth";
+
+const roles = ["owner", "editor", "reviewer", "viewer"] as const;
+type Role = typeof roles[number];
+
+export async function GET(request: Request) {
+  const user = await getChatGPTUser(); if (!user) return Response.json({ error: "Sign-in is required." }, { status: 401 });
+  try { const site = new URL(request.url).searchParams.get("site") || "demo"; const members = await getDb().select().from(siteMembers).where(eq(siteMembers.siteId, site)); if (!members.some((member) => member.userId === user.userId && member.role === "owner")) return Response.json({ error: "Only the site owner can view members." }, { status: 403 }); return Response.json({ members }); } catch { return Response.json({ error: "Membership storage is unavailable." }, { status: 503 }); }
+}
+
+export async function POST(request: Request) {
+  const owner = await getChatGPTUser(); if (!owner) return Response.json({ error: "Sign-in is required." }, { status: 401 });
+  const body = await request.json().catch(() => null) as { userId?: string; email?: string; role?: Role } | null; if (!body?.userId || !body.email || !body.role || !roles.includes(body.role)) return Response.json({ error: "A user, email, and valid role are required." }, { status: 400 });
+  try { const db = getDb(); const site = new URL(request.url).searchParams.get("site") || "demo"; const isOwner = (await db.select().from(siteMembers).where(eq(siteMembers.siteId, site))).some((member) => member.userId === owner.userId && member.role === "owner"); if (!isOwner) return Response.json({ error: "Only the site owner can manage members." }, { status: 403 }); await db.insert(siteMembers).values({ siteId: site, userId: body.userId, email: body.email, role: body.role, createdAt: new Date().toISOString() }); return Response.json({ added: true }, { status: 201 }); } catch { return Response.json({ error: "Membership storage is unavailable." }, { status: 503 }); }
+}
+
+async function ownerFor(request: Request) {
+  const user = await getChatGPTUser();
+  if (!user) return { error: Response.json({ error: "Sign-in is required." }, { status: 401 }) };
+  const site = new URL(request.url).searchParams.get("site") || "demo";
+  const members = await getDb().select().from(siteMembers).where(eq(siteMembers.siteId, site));
+  if (!members.some((member) => member.userId === user.userId && member.role === "owner")) return { error: Response.json({ error: "Only the site owner can manage members." }, { status: 403 }) };
+  return { site };
+}
+
+export async function PATCH(request: Request) {
+  try {
+    const access = await ownerFor(request); if (access.error) return access.error;
+    const body = await request.json().catch(() => null) as { id?: number; role?: Role } | null;
+    if (!body?.id || !body.role || !roles.includes(body.role)) return Response.json({ error: "A member and valid role are required." }, { status: 400 });
+    await getDb().update(siteMembers).set({ role: body.role }).where(eq(siteMembers.id, body.id));
+    return Response.json({ updated: true });
+  } catch { return Response.json({ error: "Membership storage is unavailable." }, { status: 503 }); }
+}
+
+export async function DELETE(request: Request) {
+  try {
+    const access = await ownerFor(request); if (access.error) return access.error;
+    const id = Number(new URL(request.url).searchParams.get("id"));
+    if (!Number.isInteger(id) || id <= 0) return Response.json({ error: "A valid member is required." }, { status: 400 });
+    const member = (await getDb().select().from(siteMembers).where(eq(siteMembers.id, id)).limit(1))[0];
+    if (!member || member.siteId !== access.site) return Response.json({ error: "Member not found." }, { status: 404 });
+    if (member.role === "owner") return Response.json({ error: "The site owner cannot be removed." }, { status: 400 });
+    await getDb().delete(siteMembers).where(eq(siteMembers.id, id));
+    return Response.json({ removed: true });
+  } catch { return Response.json({ error: "Membership storage is unavailable." }, { status: 503 }); }
+}
