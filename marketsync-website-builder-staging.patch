+"use client";
+import { useRef, useState } from "react";
+import type { SiteAsset } from "./types";
+
+export function MediaLibrary({ assets, onChange }: { assets: SiteAsset[]; onChange: (assets: SiteAsset[]) => void }) {
+  const input = useRef<HTMLInputElement>(null); const [status, setStatus] = useState("");
+  const addFiles = async (files: FileList | null) => { for (const file of Array.from(files ?? []).filter((item) => item.type.startsWith("image/") || item.type.startsWith("video/"))) { const form = new FormData(); form.append("file", file); try { const response = await fetch("/api/website/assets?site=demo", { method: "POST", body: form }); if (response.ok) { const payload = await response.json() as { asset: SiteAsset }; onChange([...assets, payload.asset]); setStatus("Uploaded to media storage"); continue; } } catch { /* local fallback below */ } const reader = new FileReader(); reader.onload = () => onChange([...assets, { id: crypto.randomUUID(), name: file.name, src: String(reader.result), type: file.type.startsWith("video/") ? "video" : "image", size: file.size }]); reader.readAsDataURL(file); setStatus("Saved for this browser; sign in for durable storage"); } };
+  const updateAlt = async (asset: SiteAsset, alt: string) => { onChange(assets.map((item) => item.id === asset.id ? { ...item, alt } : item)); if (asset.src.startsWith("/api/")) { const response = await fetch(asset.src, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ alt }) }); setStatus(response.ok ? "Alt text saved" : "Alt text saved locally"); } else setStatus("Alt text saved locally"); };
+  return <section className="media-library" aria-label="Media library"><div className="theme-controls-heading"><div><small>CONTENT</small><h2>Media library</h2></div><button className="icon-button" onClick={() => input.current?.click()}>＋</button></div><p>Upload once and reuse assets across sections and pages.</p><input ref={input} hidden type="file" accept="image/*,video/*" multiple onChange={(event) => addFiles(event.target.files)} /><button className="media-upload" onClick={() => input.current?.click()}>Upload media</button>{status && <div className="media-status" role="status">{status}</div>}<div className="media-grid">{assets.length ? assets.map((asset) => <figure key={asset.id}>{asset.type === "image" ? <img src={asset.src} srcSet={asset.src.startsWith("/api/") ? [320, 640, 960].map((width) => `${asset.src}?width=${width}&format=webp ${width}w`).join(", ") : undefined} sizes="(max-width: 600px) 45vw, 180px" alt={asset.alt ?? asset.name} /> : <div className="media-video">VIDEO</div>}<figcaption><span>{asset.name}</span>{asset.type === "image" && <input aria-label={`Alt text for ${asset.name}`} value={asset.alt ?? ""} placeholder="Add alt text" onChange={(event) => updateAlt(asset, event.target.value)} />}</figcaption></figure>) : <div className="media-empty">No uploaded assets yet.</div>}</div></section>;
+}
