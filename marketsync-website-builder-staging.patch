+
+export async function GET(_request: Request, context: { params: Promise<{ id: string }> }) {
+  try { const { id } = await context.params; const asset = (await getDb().select().from(siteAssets).where(eq(siteAssets.id, id)).limit(1))[0]; if (!asset || !env.MEDIA) return new Response("Not found", { status: 404 }); const object = await env.MEDIA.get(asset.objectKey); if (!object) return new Response("Not found", { status: 404 }); const requestUrl = new URL(request.url); const width = Number(requestUrl.searchParams.get("width") || 0); const format = requestUrl.searchParams.get("format"); if (width > 0 && width <= 2400 && (format === "webp" || format === "avif") && env.IMAGES) { const transformed = await env.IMAGES.input(object.body).transform({ width }).output({ format, quality: 82 }); const response = await transformed.response(); response.headers.set("cache-control", "public, max-age=31536000, immutable"); response.headers.set("vary", "accept"); return response; } return new Response(object.body, { headers: { "content-type": asset.mimeType, "cache-control": "public, max-age=31536000, immutable", "etag": object.httpEtag } }); } catch { return new Response("Media unavailable", { status: 503 }); }
+}
+
+export async function PATCH(request: Request, context: { params: Promise<{ id: string }> }) {
+  const user = await getChatGPTUser(); if (!user) return Response.json({ error: "Sign-in is required." }, { status: 401 });
+  const { id } = await context.params; const body = await request.json().catch(() => null) as { alt?: string; name?: string } | null;
+  try { const db = getDb(); const asset = (await db.select().from(siteAssets).where(eq(siteAssets.id, id)).limit(1))[0]; if (!asset) return Response.json({ error: "Asset not found." }, { status: 404 }); const members = await db.select().from(siteMembers).where(eq(siteMembers.siteId, asset.siteId)); const allowed = asset.ownerId === user.userId || members.some((member) => member.userId === user.userId && ["owner", "editor"].includes(member.role)); if (!allowed) return Response.json({ error: "You do not have permission to edit this asset." }, { status: 403 }); await db.update(siteAssets).set({ alt: typeof body?.alt === "string" ? body.alt.slice(0, 300) : asset.alt, name: typeof body?.name === "string" ? body.name.slice(0, 200) : asset.name }).where(eq(siteAssets.id, id)); return Response.json({ saved: true }); } catch { return Response.json({ error: "Asset metadata storage is unavailable." }, { status: 503 }); }
+}
