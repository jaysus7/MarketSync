@@ -0,0 +1,74 @@
+import { eq } from "drizzle-orm";
+import { getDb } from "../../../../db";
+import { siteMembers, websiteDocuments, websiteRevisions } from "../../../../db/schema";
+import { starterDocument, type WebsiteDocument } from "../../../website-builder/types";
+import { getChatGPTUser } from "../../../chatgpt-auth";
+
+const siteId = (request: Request) => new URL(request.url).searchParams.get("site") || "demo";
+const can = (role: string | null, allowed: string[]) => Boolean(role && allowed.includes(role));
+
+export async function GET(request: Request) {
+  try {
+    if (new URL(request.url).searchParams.get("revisions") === "1") {
+      const rows = await getDb().select().from(websiteRevisions).where(eq(websiteRevisions.siteId, siteId(request))).limit(50);
+      return Response.json({ revisions: rows.map((row) => ({ id: String(row.id), label: row.label, createdAt: row.createdAt, document: JSON.parse(row.documentJson) as WebsiteDocument })) });
+    }
+    const rows = await getDb().select().from(websiteDocuments).where(eq(websiteDocuments.siteId, siteId(request))).limit(1);
+    const row = rows[0];
+    if (!row) return Response.json({ document: starterDocument, published: null, source: "starter" });
+    return Response.json({ document: JSON.parse(row.draftJson) as WebsiteDocument, published: row.publishedJson ? JSON.parse(row.publishedJson) as WebsiteDocument : null, version: row.version, source: "d1" });
+  } catch {
+    return Response.json({ document: starterDocument, source: "fallback" });
+  }
+}
+
+export async function POST(request: Request) {
+  const id = siteId(request);
+  const user = await getChatGPTUser();
+  if (!user) return Response.json({ error: "Sign-in is required to publish website changes." }, { status: 401 });
+  const body = await request.json().catch(() => null) as { document?: WebsiteDocument; expectedVersion?: number } | null;
+  if (!body?.document || !Array.isArray(body.document.pages)) return Response.json({ error: "A valid website document is required." }, { status: 400 });
+  try {
+    const db = getDb();
+    const current = (await db.select().from(websiteDocuments).where(eq(websiteDocuments.siteId, id)).limit(1))[0];
+    const member = (await db.select().from(siteMembers).where(eq(siteMembers.siteId, id))).find((item) => item.userId === user.userId);
+    const role = member?.role || (current?.ownerId === user.userId ? "owner" : current ? null : "owner");
+    if (!can(role, ["owner", "editor", "reviewer"])) return Response.json({ error: "You do not have permission to publish this website." }, { status: 403 });
+    if (current && body.expectedVersion !== undefined && current.version !== body.expectedVersion) return Response.json({ error: "Document changed elsewhere.", version: current.version }, { status: 409 });
+    const now = new Date().toISOString();
+    const version = current?.version ?? 1;
+    const published = { ...body.document, status: "published" as const, updatedAt: now };
+    if (current && current.ownerId && current.ownerId !== user.userId && !member) return Response.json({ error: "You do not have access to this website." }, { status: 403 });
+    if (current) await db.update(websiteDocuments).set({ ownerId: user.userId, publishedJson: JSON.stringify(published), version, updatedAt: now }).where(eq(websiteDocuments.siteId, id));
+    else await db.insert(websiteDocuments).values({ siteId: id, ownerId: user.userId, draftJson: JSON.stringify({ ...body.document, status: "draft" }), publishedJson: JSON.stringify(published), version, updatedAt: now });
+    return Response.json({ published: true, version, document: published });
+  } catch {
+    return Response.json({ error: "Durable publishing is unavailable." }, { status: 503 });
+  }
+}
+
+export async function PUT(request: Request) {
+  const id = siteId(request);
+  const user = await getChatGPTUser();
+  if (!user) return Response.json({ error: "Sign-in is required to save website changes." }, { status: 401 });
+  const body = await request.json().catch(() => null) as { document?: WebsiteDocument; label?: string; expectedVersion?: number } | null;
+  if (!body?.document || !Array.isArray(body.document.pages)) return Response.json({ error: "A valid website document is required." }, { status: 400 });
+  try {
+    const db = getDb();
+    const current = (await db.select().from(websiteDocuments).where(eq(websiteDocuments.siteId, id)).limit(1))[0];
+    const member = (await db.select().from(siteMembers).where(eq(siteMembers.siteId, id))).find((item) => item.userId === user.userId);
+    const role = member?.role || (current?.ownerId === user.userId ? "owner" : current ? null : "owner");
+    if (!can(role, ["owner", "editor"])) return Response.json({ error: "You do not have permission to edit this website." }, { status: 403 });
+    if (current && body.expectedVersion !== undefined && current.version !== body.expectedVersion) return Response.json({ error: "Document changed elsewhere.", version: current.version }, { status: 409 });
+    const now = new Date().toISOString();
+    const nextVersion = (current?.version ?? 0) + 1;
+    const document = { ...body.document, status: "draft" as const, version: nextVersion, updatedAt: now };
+    if (current && current.ownerId && current.ownerId !== user.userId && !member) return Response.json({ error: "You do not have access to this website." }, { status: 403 });
+    if (current) await db.update(websiteDocuments).set({ ownerId: user.userId, draftJson: JSON.stringify(document), version: nextVersion, updatedAt: now }).where(eq(websiteDocuments.siteId, id));
+    else await db.insert(websiteDocuments).values({ siteId: id, ownerId: user.userId, draftJson: JSON.stringify(document), version: nextVersion, updatedAt: now });
+    await db.insert(websiteRevisions).values({ siteId: id, ownerId: user.userId, label: body.label || "Draft saved", documentJson: JSON.stringify(document), createdAt: now });
+    return Response.json({ saved: true, document, version: nextVersion, source: "d1" });
+  } catch {
+    return Response.json({ error: "Durable storage is unavailable." }, { status: 503 });
+  }
+}
diff --git a/app/api/website/members/route.ts b/app/api/website/members/route.ts
new file mode 100644
index 0000000..89f044f
