+import { useEffect, useState } from "react";
+import type { SiteGovernance, WebsiteDocument } from "./types";
+
+type Member = { id: number; userId: string; email: string; role: string };
+const fallbackGovernance: SiteGovernance = { approval: "draft", locked: { logo: false, fonts: false, legal: false, navigation: false }, auditLog: [] };
+
+export function GovernanceControls({ document, onChange }: { document: WebsiteDocument; onChange: (governance: SiteGovernance) => void }) {
+  const current = document.governance ?? fallbackGovernance; const [members, setMembers] = useState<Member[]>([]); const [email, setEmail] = useState(""); const [userId, setUserId] = useState(""); const [role, setRole] = useState("editor"); const [status, setStatus] = useState("");
+  useEffect(() => { fetch("/api/website/members?site=demo").then((response) => response.ok ? response.json() : Promise.reject()).then((payload: { members?: Member[] }) => setMembers(payload.members ?? [])).catch(() => undefined); }, []);
+  const update = (patch: Partial<SiteGovernance>, action: string) => onChange({ ...current, ...patch, auditLog: [{ id: crypto.randomUUID(), action, createdAt: new Date().toISOString() }, ...current.auditLog].slice(0, 50) });
+  const invite = async () => { if (!email.trim() || !userId.trim()) return; const response = await fetch("/api/website/members?site=demo", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ email, userId, role }) }); if (!response.ok) { setStatus("Could not add member."); return; } setMembers((items) => [...items, { id: Date.now(), email, userId, role }]); setEmail(""); setUserId(""); setStatus("Member added."); };
+  const updateRole = async (member: Member, nextRole: string) => { const response = await fetch("/api/website/members?site=demo", { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: member.id, role: nextRole }) }); if (!response.ok) { setStatus("Could not update role."); return; } setMembers((items) => items.map((item) => item.id === member.id ? { ...item, role: nextRole } : item)); setStatus("Role updated."); };
+  const remove = async (member: Member) => { if (!window.confirm(`Remove ${member.email}?`)) return; const response = await fetch(`/api/website/members?site=demo&id=${member.id}`, { method: "DELETE" }); if (!response.ok) { setStatus("Could not remove member."); return; } setMembers((items) => items.filter((item) => item.id !== member.id)); setStatus("Member removed."); };
+  return <section className="governance-controls" role="dialog" aria-label="Enterprise governance"><div className="theme-controls-heading"><div><small>ENTERPRISE</small><h2>Governance</h2></div></div><p>Control brand ownership, approvals, and team access.</p><div className="theme-control-group"><strong>Approval status</strong><select value={current.approval} onChange={(event) => update({ approval: event.target.value as SiteGovernance["approval"] }, `Approval changed to ${event.target.value}`)}><option value="draft">Draft</option><option value="submitted">Submitted for approval</option><option value="approved">Approved</option></select></div><div className="theme-control-group"><strong>Team members</strong>{members.map((member) => <div className="governance-event" key={member.id}><span>{member.email}</span>{member.role === "owner" ? <small>Owner</small> : <><select aria-label={`Role for ${member.email}`} value={member.role} onChange={(event) => updateRole(member, event.target.value)}><option value="editor">Editor</option><option value="reviewer">Reviewer</option><option value="viewer">Viewer</option></select><button className="member-remove" onClick={() => remove(member)} aria-label={`Remove ${member.email}`}>×</button></>}</div>)}<input className="chrome-input" value={email} onChange={(event) => setEmail(event.target.value)} placeholder="Member email" /><input className="chrome-input" value={userId} onChange={(event) => setUserId(event.target.value)} placeholder="Authenticated user ID" /><select value={role} onChange={(event) => setRole(event.target.value)}><option value="editor">Editor</option><option value="reviewer">Reviewer</option><option value="viewer">Viewer</option></select><button className="outline-action" onClick={invite}>＋ Add member</button>{status && <small className="media-status">{status}</small>}</div><div className="theme-control-group"><strong>Locked master-brand controls</strong>{([['logo','Logo'],['fonts','Fonts'],['legal','Legal content'],['navigation','Navigation']] as const).map(([key,label]) => <label className="governance-toggle" key={key}><input type="checkbox" checked={current.locked[key]} onChange={(event) => update({ locked: { ...current.locked, [key]: event.target.checked } }, `${label} ${event.target.checked ? "locked" : "unlocked"}`)} /> {label}<small>{current.locked[key] ? "Locked by group" : "Editable locally"}</small></label>)}</div></section>;
+}
