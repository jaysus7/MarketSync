--- /dev/null
+++ b/app/api/crm/leads/route.ts
@@ -0,0 +1,16 @@
+import { NextResponse } from "next/server";
+
+const forms = new Set(["contact", "request-information", "book-test-drive", "service-booking", "finance", "trade-in"]);
+
+export async function POST(request: Request) {
+  const body = await request.json().catch(() => null) as Record<string, unknown> | null;
+  if (!body || typeof body.form !== "string" || !forms.has(body.form) || typeof body.name !== "string" || typeof body.email !== "string" || body.consent !== true) {
+    return NextResponse.json({ error: "A valid form, name, email, and consent are required." }, { status: 400 });
+  }
+  const webhook = process.env.MARKETSYNC_CRM_INGEST_URL;
+  if (webhook) {
+    const response = await fetch(webhook, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...body, source: "website-builder" }) });
+    if (!response.ok) return NextResponse.json({ error: "CRM ingestion failed." }, { status: 502 });
+  }
+  return NextResponse.json({ accepted: true, source: "website-builder", forwarded: Boolean(webhook) }, { status: 202 });
+}
