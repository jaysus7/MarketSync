+  try { const site = new URL(request.url).searchParams.get("site") || "demo"; const assets = await getDb().select().from(siteAssets).where(eq(siteAssets.siteId, site)); return Response.json({ assets: assets.map((asset) => ({ id: asset.id, name: asset.name, src: `/api/website/assets/${asset.id}`, type: asset.mimeType.startsWith("video/") ? "video" : "image", alt: asset.alt ?? undefined, size: asset.size ?? undefined })) }); } catch { return Response.json({ assets: [] }); }
+}
+
+export async function POST(request: Request) {
+  const user = await getChatGPTUser();
+  if (!user) return Response.json({ error: "Sign-in is required to upload media." }, { status: 401 });
+  const form = await request.formData(); const file = form.get("file"); if (!(file instanceof File) || (!file.type.startsWith("image/") && !file.type.startsWith("video/"))) return Response.json({ error: "Only image and video uploads are supported." }, { status: 400 });
+  try { if (!env.MEDIA) throw new Error("R2 unavailable"); const id = crypto.randomUUID(); const key = `sites/demo/assets/${id}-${file.name.replace(/[^a-zA-Z0-9._-]/g, "-")}`; await env.MEDIA.put(key, file.stream(), { httpMetadata: { contentType: file.type } }); const now = new Date().toISOString(); await getDb().insert(siteAssets).values({ id, siteId: "demo", ownerId: user.userId, name: file.name, objectKey: key, mimeType: file.type, alt: String(form.get("alt") || ""), size: file.size, createdAt: now }); return Response.json({ asset: { id, name: file.name, src: `/api/website/assets/${id}`, type: file.type.startsWith("video/") ? "video" : "image", size: file.size } }, { status: 201 }); } catch { return Response.json({ error: "Durable media storage is unavailable." }, { status: 503 }); }
