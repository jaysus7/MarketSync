+"use client";
+import { useState } from "react";
+import type { Section, WebsiteDocument } from "./types";
+
+export function BuilderAssistant({ document, onChange, onClose }: { document: WebsiteDocument; onChange: (document: WebsiteDocument, message: string) => void; onClose: () => void }) {
+  const [command, setCommand] = useState("");
+  const [message, setMessage] = useState("Try: add a used inventory section or make the hero darker.");
+  const run = () => { const text = command.trim().toLowerCase(); if (!text) return; const page = document.pages.find((item) => item.id === document.activePageId) ?? document.pages[0]; if (!page) return; let next = document; let result = ""; if (text.includes("add") && text.includes("inventory")) { const inventory: Section = { id: `inventory-${crypto.randomUUID()}`, type: "inventory", label: "AI-added inventory", content: { eyebrow: "LIVE INVENTORY", heading: "Used vehicles worth a closer look.", body: "Browse current pre-owned inventory with clear pricing and useful details.", primaryAction: "Browse used vehicles" }, styles: { background: "canvas", accent: "lime", align: "left" } }; next = { ...document, pages: document.pages.map((item) => item.id === page.id ? { ...item, sections: [...item.sections, inventory] } : item) }; result = "Added a structured inventory section to the current page."; } else if (text.includes("hero") && (text.includes("dark") || text.includes("darker"))) { next = { ...document, pages: document.pages.map((item) => item.id === page.id ? { ...item, sections: item.sections.map((section) => section.type === "hero" ? { ...section, styles: { ...section.styles, background: "ink" } } : section) } : item) }; result = "Updated the hero background using the theme system."; } else if (text.includes("mobile") && (text.includes("smaller") || text.includes("reduce"))) { next = { ...document, pages: document.pages.map((item) => item.id === page.id ? { ...item, sections: item.sections.map((section) => section.type === "hero" ? { ...section, styles: { ...section.styles, mobile: { ...section.styles.mobile, paddingTop: 48, paddingBottom: 48 } } } : section) } : item) }; result = "Reduced hero spacing on mobile with a breakpoint override."; } else { setMessage("I can safely add inventory, darken the hero, or reduce mobile hero spacing right now."); return; } setMessage(result); onChange(next, result); setCommand(""); };
+  return <section className="assistant-panel" role="dialog" aria-label="Structured website assistant"><div className="theme-controls-heading"><div><small>MARKETSYNC ASSISTANT</small><h2>Make a change</h2></div><button className="icon-button" onClick={onClose}>×</button></div><p>Describe a change and the assistant will edit structured sections only.</p><div className="assistant-form"><input value={command} onChange={(event) => setCommand(event.target.value)} onKeyDown={(event) => { if (event.key === "Enter") run(); }} placeholder="Make the hero darker" /><button onClick={run}>Apply</button></div><div className="assistant-message">{message}</div><div className="assistant-examples"><button onClick={() => setCommand("Add a used inventory section")}>Add inventory</button><button onClick={() => setCommand("Make the hero darker")}>Darken hero</button><button onClick={() => setCommand("Make the mobile hero smaller")}>Tighten mobile</button></div></section>;
+}
